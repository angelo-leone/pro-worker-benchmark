# Copy this to .env and fill in your API keys
# ================================================
# Both providers are used to maximize model coverage within budget.

# DigitalOcean Gradient AI Platform
# Used for: proprietary models (GPT-4o, Claude), DO-hosted open models, all 3 judges
# Get your key: https://cloud.digitalocean.com/gen-ai/serverless-inference
DO_API_KEY=your-digitalocean-api-key-here

# Vultr Serverless Inference
# Used for: Mistral (not on DO), Llama 3.1 (version comparison)
# Get your key: https://my.vultr.com/inference/
VULTR_API_KEY=your-vultr-api-key-here
